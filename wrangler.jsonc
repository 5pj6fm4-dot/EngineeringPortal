{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "engineeringportal",
  "main": "worker.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/*"],
    "not_found_handling": "none",
    "html_handling": "none"
  }
}
